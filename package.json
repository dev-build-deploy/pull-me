{
  "name": "pull-me",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "description": "Pull request descriptions that carry their own proof: the Why, How, Review hints and Proof sections, checked, with Vale for plain English",
  "author": "Kevin de Jong",
  "license": "MIT",
  "homepage": "https://github.com/dev-build-deploy/pull-me",
  "keywords": [
    "github",
    "action",
    "pull-request",
    "vale",
    "claude-code"
  ],
  "bugs": {
    "url": "https://github.com/dev-build-deploy/pull-me/issues"
  },
  "scripts": {
    "build": "run-p build:* && npm run check:bundle",
    "check:bundle": "node scripts/check-bundle.mjs lib claude-plugin/bundle",
    "build:cli": "ncc build -o lib/cli src/entrypoints/cli.ts",
    "build:action": "ncc build -o lib/action src/entrypoints/action.ts",
    "build:plugin": "ncc build -o claude-plugin/bundle src/entrypoints/cli.ts && node scripts/copy-vale.mjs claude-plugin/bundle/vale",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint --ext .ts src test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "setup-hooks": "pre-commit install --hook-type pre-commit --hook-type commit-msg",
    "test:bin": "node scripts/smoke-bin.mjs",
    "test:plugin": "claude plugin test claude-plugin"
  },
  "bin": {
    "pull-me": "./bin/pull-me"
  },
  "dependencies": {
    "@actions/core": "^3",
    "@actions/github": "^9",
    "@dev-build-deploy/commit-it": "^2",
    "@dev-build-deploy/diagnose-it": "^1",
    "commander": "^15"
  },
  "devDependencies": {
    "@jest/globals": "^29",
    "@types/jest": "^29",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vercel/ncc": "^0",
    "eslint": "^8",
    "eslint-import-resolver-typescript": "^3",
    "eslint-plugin-import": "^2",
    "eslint-plugin-jest": "^28",
    "jest": "^29",
    "npm-run-all2": "^6",
    "prettier": "^3",
    "ts-jest": "^29",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  }
}
